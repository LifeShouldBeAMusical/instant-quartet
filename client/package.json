{
	"name": "instant-quartet",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc && vite build",
		"preview": "vite preview",
		"test:e2e": "cypress run",
		"test:unit": "vitest",
		"lint": "eslint . --fix",
		"lint-check": "eslint .",
		"format": "prettier --write ./",
		"format-check": "prettier --check ./",
		"type-check": "vue-tsc --build",
		"codegen": "graphql-codegen"
	},
	"dependencies": {
		"@apollo/client": "^3.14.1",
		"@capacitor/android": "^8.4.0",
		"@capacitor/app": "8.1.0",
		"@capacitor/camera": "^8.2.0",
		"@capacitor/core": "8.4.0",
		"@capacitor/haptics": "8.0.2",
		"@capacitor/ios": "^8.4.1",
		"@capacitor/keyboard": "8.0.5",
		"@capacitor/status-bar": "8.0.2",
		"@ionic/pwa-elements": "^3.4.0",
		"@ionic/vue": "^8.8.10",
		"@ionic/vue-router": "^8.8.10",
		"@vue/apollo-composable": "^4.2.2",
		"fuse.js": "^7.4.2",
		"graphql": "^16.14.2",
		"ionicons": "^8.0.13",
		"pinia": "^3.0.4",
		"qrcode.vue": "^3.10.0",
		"vue": "^3.5.38",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@capacitor/cli": "8.4.0",
		"@graphql-codegen/cli": "^7.1.3",
		"@graphql-codegen/client-preset": "^6.0.1",
		"@graphql-codegen/typescript": "^6.0.2",
		"@graphql-codegen/typescript-operations": "^6.0.4",
		"@graphql-codegen/typescript-vue-apollo": "^5.0.1",
		"@vitejs/plugin-legacy": "^8.0.2",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vitest/eslint-plugin": "^1.6.20",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.8.0",
		"@vue/test-utils": "^2.4.11",
		"cypress": "^15.17.0",
		"eslint": "^9.39.4",
		"eslint-plugin-vue": "^9.33.0",
		"jiti": "^2.7.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.4",
		"sass-embedded": "^1.100.0",
		"terser": "^5.48.0",
		"typescript": "~5.9.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.9",
		"vue-tsc": "^3.3.5"
	},
	"description": "An application for finding common songs between barbershoppers"
}
