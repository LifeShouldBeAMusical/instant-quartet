{
	"name": "instant-quartet",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc && vite build",
		"preview": "vite preview",
		"test:e2e": "cypress run",
		"test:unit": "vitest",
		"lint": "eslint . --fix",
		"lint-check": "eslint .",
		"format": "prettier --write ./",
		"format-check": "prettier --check ./",
		"type-check": "vue-tsc --build",
		"codegen": "graphql-codegen"
	},
	"dependencies": {
		"@apollo/client": "^3.14.1",
		"@capacitor/android": "^8.4.2",
		"@capacitor/app": "8.1.1",
		"@capacitor/camera": "^8.2.1",
		"@capacitor/core": "8.4.2",
		"@capacitor/haptics": "8.0.2",
		"@capacitor/ios": "^8.4.2",
		"@capacitor/keyboard": "8.0.5",
		"@capacitor/status-bar": "8.0.3",
		"@ionic/pwa-elements": "^3.4.0",
		"@ionic/vue": "^8.8.15",
		"@ionic/vue-router": "^8.8.15",
		"@vue/apollo-composable": "^4.2.2",
		"fuse.js": "^7.5.0",
		"graphql": "^16.14.2",
		"ionicons": "^8.0.13",
		"pinia": "^4.0.2",
		"qrcode.vue": "^3.10.0",
		"vue": "^3.5.38",
		"vue-router": "^5.2.0"
	},
	"devDependencies": {
		"@capacitor/cli": "8.4.2",
		"@graphql-codegen/cli": "^7.2.0",
		"@graphql-codegen/client-preset": "^6.1.0",
		"@graphql-codegen/typescript": "^6.1.0",
		"@graphql-codegen/typescript-operations": "^6.1.2",
		"@graphql-codegen/typescript-vue-apollo": "^5.0.1",
		"@vitejs/plugin-legacy": "^8.2.2",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vitest/eslint-plugin": "^1.6.24",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.4.11",
		"cypress": "^15.19.0",
		"eslint": "^9.39.5",
		"eslint-plugin-vue": "^9.33.0",
		"jiti": "^2.7.0",
		"jsdom": "^30.0.0",
		"prettier": "^3.9.6",
		"sass-embedded": "^1.100.0",
		"terser": "^5.49.0",
		"typescript": "~5.9.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"vue-tsc": "^3.3.8"
	},
	"description": "An application for finding common songs between barbershoppers"
}
